{
  "name": "scp-fast",
  "displayName": "SCP-Fast",
  "description": "在 Remote-SSH 资源管理器中，通过 Windows 本机 scp 快速上传和下载文件。",
  "version": "1.1.1",
  "publisher": "scp-fast-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "scp",
    "ssh",
    "remote",
    "upload",
    "download"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:helper": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-helper.ps1",
    "test": "node scripts/test.mjs",
    "vscode:prepublish": "npm run check && npm run build:helper && npm run build",
    "package": "vsce package --target win32-x64 --no-dependencies --allow-missing-repository -o artifacts/scp-fast-1.1.1-win32-x64.vsix"
  },
  "contributes": {
    "commands": [
      {
        "command": "scpFast.download",
        "title": "快速下载到本机",
        "category": "SCP-Fast"
      },
      {
        "command": "scpFast.downloadMany",
        "title": "批量下载到本机",
        "category": "SCP-Fast"
      },
      {
        "command": "scpFast.upload",
        "title": "上传本机文件到此处",
        "category": "SCP-Fast"
      },
      {
        "command": "scpFast.showQueue",
        "title": "显示传输队列",
        "category": "SCP-Fast",
        "icon": "$(list-ordered)"
      },
      {
        "command": "scpFast.cancel",
        "title": "取消任务",
        "category": "SCP-Fast",
        "icon": "$(debug-stop)"
      },
      {
        "command": "scpFast.retry",
        "title": "从头重试",
        "category": "SCP-Fast",
        "icon": "$(refresh)"
      },
      {
        "command": "scpFast.openFolder",
        "title": "打开本机所在文件夹",
        "category": "SCP-Fast",
        "icon": "$(folder-opened)"
      },
      {
        "command": "scpFast.showLog",
        "title": "查看传输日志",
        "category": "SCP-Fast",
        "icon": "$(output)"
      },
      {
        "command": "scpFast.selectHost",
        "title": "重新选择当前服务器 SSH 条目",
        "category": "SCP-Fast"
      },
      {
        "command": "scpFast.clearFinished",
        "title": "清除已结束任务",
        "category": "SCP-Fast",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "scpFast.download",
          "when": "scpFast.available && resourceScheme == vscode-remote && !listMultiSelection",
          "group": "scpFast@1"
        },
        {
          "command": "scpFast.downloadMany",
          "when": "scpFast.available && resourceScheme == vscode-remote && listMultiSelection",
          "group": "scpFast@1"
        },
        {
          "command": "scpFast.upload",
          "when": "scpFast.available && resourceScheme == vscode-remote && explorerResourceIsFolder && !listMultiSelection",
          "group": "scpFast@2"
        }
      ],
      "view/title": [
        {
          "command": "scpFast.showLog",
          "when": "view == scpFast.transfers",
          "group": "navigation@1"
        },
        {
          "command": "scpFast.clearFinished",
          "when": "view == scpFast.transfers",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "scpFast.cancel",
          "when": "view == scpFast.transfers && viewItem == scpFast.active",
          "group": "inline@1"
        },
        {
          "command": "scpFast.retry",
          "when": "view == scpFast.transfers && viewItem == scpFast.retryable",
          "group": "inline@1"
        },
        {
          "command": "scpFast.openFolder",
          "when": "view == scpFast.transfers && viewItem == scpFast.downloaded",
          "group": "inline@1"
        },
        {
          "command": "scpFast.showLog",
          "when": "view == scpFast.transfers",
          "group": "scpFast@2"
        }
      ],
      "commandPalette": [
        {
          "command": "scpFast.downloadMany",
          "when": "false"
        },
        {
          "command": "scpFast.cancel",
          "when": "false"
        },
        {
          "command": "scpFast.retry",
          "when": "false"
        },
        {
          "command": "scpFast.openFolder",
          "when": "false"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "scpFast.transfers",
          "name": "SCP-Fast 传输",
          "when": "scpFast.available"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "scpFast.transfers",
        "contents": "右键服务器文件或文件夹，下载到本机。\n右键服务器文件夹，上传本机文件。\n\n[查看日志](command:scpFast.showLog)"
      }
    ],
    "configuration": {
      "title": "SCP-Fast",
      "properties": {
        "scpFast.scpPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "本机 scp.exe 的绝对路径。为空时沿用 SSH 程序同目录的 scp.exe，再使用 Windows OpenSSH。"
        },
        "scpFast.sshPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "本机 ssh.exe 的绝对路径。为空时沿用 remote.SSH.path，再使用 Windows OpenSSH。需要 OpenSSH 9.0 或更新版本。"
        },
        "scpFast.sshConfigPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "本机 SSH 配置文件路径。为空时沿用 remote.SSH.configFile，再使用 ~/.ssh/config。"
        },
        "scpFast.diagnosticLogging": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "为后续传输启用 scp -v 诊断日志。不会保存认证输入，但日志可能包含主机、用户名和文件路径。"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "ssh2": "^1.17.0",
    "typescript": "^5.8.0"
  }
}
